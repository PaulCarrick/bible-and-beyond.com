# Copy to docker/.env and fill in. Read by docker/compose.yml. Keep docker/.env private: it holds the
# passwords and keys.

# ---- Required ---------------------------------------------------------------------------------------

# Passwords for the two databases inside the containers (letters, digits, - and _ only; make them long
# and random, e.g. openssl rand -hex 16). They are set the first time the database container starts.
POSTGRES_PASSWORD=
DRUPAL_DATABASE_PASSWORD=

# The first administrator of the Drupal admin, made on the first start. With no ADMIN_PASSWORD a random
# one is made and shown once in the log (docker compose -f docker/compose.yml logs web).
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The public address of the site, as visitors type it (used in the links the site emails).
SITE_URL=http://localhost

# ---- The site ---------------------------------------------------------------------------------------

# Set on the first start; change them later on the admin's Site settings screen.
SITE_TITLE=Bible and Beyond
# The site's own copyright line in the footer (empty: none).
SITE_COPYRIGHT=

# The host ports. The public site and the admin are plain HTTP: on a server, put a proxy that handles
# HTTPS in front of them (see docker/README.md).
SITE_PORT=80
ADMIN_PORT=8081

# The admin's host names, as comma-separated regular expressions (localhost and 127.0.0.1 always work),
# e.g. ^admin\.example\.org$
DRUPAL_TRUSTED_HOSTS=

# ---- Email (contact form, account links, daily devotionals) ------------------------------------------

# Saved on the first start; change them later on the admin's Site settings screen. Without them the
# site sends no email (the contact form and the account emails say they could not be sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# login, plain, cram-md5 or none
SMTP_AUTHENTICATION=login
SMTP_DEFAULT_DOMAIN=
# The address the site sends from, and where contact messages go (both default to ADMIN_EMAIL).
MAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_SUBJECT=Contact request from the website

# ---- Outside services (optional; each needs its own account) -----------------------------------------

# They can also be set later on the admin's Site settings screen, which then takes over.
# Google Gemini, for the AI answers on the FAQ page: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# API.Bible, for searching the NIV, NASB and The Message (free plan: non-commercial, 5,000 requests a
# month; its terms ask for the copyright notices the site shows): https://scripture.api.bible
API_BIBLE_KEY=
# Google reCAPTCHA v3, for the contact form (add your host name to the key):
# https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Rarely needed ----------------------------------------------------------------------------------

# Drupal's hash salt; when empty one is made on the first start and kept in a volume.
DRUPAL_HASH_SALT=
# Set to "off" to stop all email (for a test copy).
OUTGOING_EMAIL=on
# Where to get the images, for "docker compose pull": GitHub's registry, or the same images on Docker Hub
# (docker.io/paulcarrick).
IMAGE_REGISTRY=ghcr.io/paulcarrick
IMAGE_TAG=latest
