# User service for paul: install as ~/.config/systemd/user/bible-and-beyond-ml.service
[Unit]
Description=Bible and Beyond ML service

[Service]
WorkingDirectory=%h/bible-and-beyond.com/ml-service
ExecStart=%h/bible-and-beyond.com/ml-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
