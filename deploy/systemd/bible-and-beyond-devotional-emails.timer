# User timer for paul: install as ~/.config/systemd/user/bible-and-beyond-devotional-emails.timer
[Unit]
Description=Bible and Beyond: check for daily devotional emails every five minutes

[Timer]
OnCalendar=*:0/5
# A run missed while the server was off is made up at once when it comes back.
Persistent=true

[Install]
WantedBy=timers.target
