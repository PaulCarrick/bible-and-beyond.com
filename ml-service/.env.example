DATABASE_URL=postgresql://USER:PASSWORD@localhost:5434/bibleandbeyond
GEMINI_API_KEY=your-api-key-here
API_BIBLE_KEY=your-api-bible-key-here
API_BIBLE_ENDPOINT=https://rest.api.bible
# Google reCAPTCHA v3 (no checkbox) for the contact form: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Optional: the lowest score (0 to 1) that counts as a person; 0.5 when not set.
# RECAPTCHA_MINIMUM_SCORE=0.5
# Optional: how to run drush, which the contact form uses to read the email settings kept in Drupal.
# Default is drupal/vendor/bin/drush (right on the server). On a Mac with DDEV use: DRUSH_COMMAND=ddev drush
# DRUSH_COMMAND=ddev drush
