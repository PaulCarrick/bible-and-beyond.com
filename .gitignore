# Python
ml-service/.venv/
__pycache__/
*.pyc

# Node
frontend/node_modules/
frontend/dist/

# Drupal
drupal/vendor/
drupal/web/core/
drupal/web/modules/contrib/
drupal/web/themes/contrib/
drupal/web/profiles/contrib/
drupal/web/libraries/
drupal/web/sites/*/files/
drupal/web/sites/*/settings.local.php
drupal/web/sites/*/settings.ddev.php

# OS / IDE
.DS_Store
.idea/workspace.xml
.idea/shelf/

# Secrets / environment
.env
.env.*
!.env.example

# DDEV local HTTPS certificates and private keys (generated per machine)
drupal/.ddev/traefik/

# Logs
*.log
log/

# Downloaded archives (the extracted .txt files are committed)
ml-service/data/*.zip

# Running count of API.Bible requests (kept on each machine)
ml-service/data/api_bible_usage.json
# The service keys saved on the Drupal Site settings screen (secrets; see CLAUDE.md "Service keys")
ml-service/data/service_settings.json
ml-service/data/service_settings.json.new
# Progress and logs of the commentary and devotional refreshes started from the admin
ml-service/data/refresh/

# STEPBible data files (CC BY 4.0, downloaded by hand; see CLAUDE.md "Word studies")
ml-service/data/stepbible/
ml-service/data/bsb_tables.tsv
ml-service/data/commentaries/
ml-service/data/devotionals/
ml-service/data/music/

# The production snapshot for the containers (personal data: accounts, notes, the email password; never commit)
docker/snapshot/

# The public data built into the database image (made by docker/make-public-data.sh; too large for git)
docker/public-data/
