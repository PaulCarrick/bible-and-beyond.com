<?php

/**
 * @file
 * Updates for Bible administration.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\editor\Entity\Editor;
use Drupal\filter\Entity\FilterFormat;
use Drupal\user\Entity\Role;

/**
 * Adds the "Website administrator" role: the website's own pages only.
 *
 * It may use the Bibles, Site settings and Site users pages and nothing of Drupal's own (content, blocks,
 * structure, appearance, extensions, configuration, people, reports). New sites get it from
 * config/install when the module is installed; this adds it to sites that had the module already.
 */
function bible_admin_update_11001(): string {
  if (Role::load('website_administrator')) {
    return 'The Website administrator role already exists.';
  }
  $role = Role::create([
    'id' => 'website_administrator',
    'label' => 'Website administrator',
    'weight' => 4,
  ]);
  foreach ([
    'access administration pages',
    'access navigation',
    'administer bibles',
    'administer site settings',
    'administer site users',
    'view the administration theme',
  ] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();
  return 'Added the Website administrator role.';
}

/**
 * Adds the FAQ notes page's text format and editor, and lets Website administrators use the page.
 *
 * New sites get them from config/install and config/optional when the module is installed; this adds them
 * to sites that had the module already. The editor needs CKEditor 5; without it the page shows a plain box.
 */
function bible_admin_update_11002(): string {
  $done = [];
  $directory = \Drupal::service('extension.list.module')->getPath('bible_admin') . '/config';
  if (!FilterFormat::load('faq_note')) {
    FilterFormat::create(Yaml::decode(file_get_contents($directory . '/install/filter.format.faq_note.yml')))->save();
    $done[] = 'added the FAQ note text format';
  }
  if (\Drupal::moduleHandler()->moduleExists('ckeditor5') && !Editor::load('faq_note')) {
    Editor::create(Yaml::decode(file_get_contents($directory . '/optional/editor.editor.faq_note.yml')))->save();
    $done[] = 'added its editor';
  }
  $role = Role::load('website_administrator');
  $missing = $role ? array_filter(['administer faq notes', 'use text format faq_note'], fn ($permission) => !$role->hasPermission($permission)) : [];
  if ($missing) {
    foreach ($missing as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
    $done[] = 'let Website administrators use the FAQ notes page';
  }
  return $done ? ucfirst(implode(', ', $done)) . '.' : 'Nothing to do.';
}

/**
 * Adds the Group leader role (the Groups page, own groups only) and lets Website administrators lead and see all
 * groups.
 *
 * New sites get the role from config/install; this adds it to sites that had the module already.
 */
function bible_admin_update_11003(): string {
  $done = [];
  if (!Role::load('group_leader')) {
    $role = Role::create(['id' => 'group_leader', 'label' => 'Group leader', 'weight' => 6]);
    foreach (['access administration pages', 'access navigation', 'lead groups', 'view the administration theme'] as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
    $done[] = 'added the Group leader role';
  }
  $role = Role::load('website_administrator');
  $missing = $role ? array_filter(['lead groups', 'administer groups'], fn ($permission) => !$role->hasPermission($permission)) : [];
  if ($missing) {
    foreach ($missing as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
    $done[] = 'let Website administrators lead and see all groups';
  }
  return $done ? ucfirst(implode(', ', $done)) . '.' : 'Nothing to do.';
}

/**
 * Adds the "Group email" text format and its editor (the Email a member box on a group's page, 2026-11-17) and
 * lets Group leaders and Website administrators use it.
 */
function bible_admin_update_11004(): string {
  $done = [];
  $directory = \Drupal::service('extension.list.module')->getPath('bible_admin') . '/config';
  if (!FilterFormat::load('group_email')) {
    FilterFormat::create(Yaml::decode(file_get_contents($directory . '/install/filter.format.group_email.yml')))->save();
    $done[] = 'added the Group email text format';
  }
  if (\Drupal::moduleHandler()->moduleExists('ckeditor5') && !Editor::load('group_email')) {
    Editor::create(Yaml::decode(file_get_contents($directory . '/optional/editor.editor.group_email.yml')))->save();
    $done[] = 'added its editor';
  }
  foreach (['group_leader', 'website_administrator'] as $id) {
    $role = Role::load($id);
    if ($role && !$role->hasPermission('use text format group_email')) {
      $role->grantPermission('use text format group_email');
      $role->save();
      $done[] = 'let the ' . $role->label() . ' role use it';
    }
  }
  return $done ? ucfirst(implode(', ', $done)) . '.' : 'Nothing to do.';
}

/**
 * Lets the Group leader and Website administrator roles keep their own signatures and tasks, and the Website
 * administrator see everyone's (added 2026-11-19). New sites get them from config/install.
 */
function bible_admin_update_11005(): string {
  $done = [];
  $grants = [
    'group_leader' => ['keep signatures and tasks'],
    'website_administrator' => ['keep signatures and tasks', 'administer signatures and tasks'],
  ];
  foreach ($grants as $id => $permissions) {
    $role = Role::load($id);
    if (!$role) {
      continue;
    }
    $added = array_values(array_filter($permissions, fn ($permission) => !$role->hasPermission($permission)));
    foreach ($added as $permission) {
      $role->grantPermission($permission);
    }
    if ($added) {
      $role->save();
      $done[] = 'let the ' . $role->label() . ' role ' . implode(' and ', $added);
    }
  }
  return $done ? ucfirst(implode('; ', $done)) . '.' : 'Nothing to do.';
}

/**
 * Adds the Font buttons (font, size, text colour and highlight; bible_admin.ckeditor5.yml) to the group email and
 * FAQ note editors, after the text styles (added 2026-11-19). New sites get them from config/optional.
 */
function bible_admin_update_11006(): string {
  $done = [];
  $buttons = ['fontFamily', 'fontSize', 'fontColor', 'fontBackgroundColor'];
  foreach (['group_email' => 'strikethrough', 'faq_note' => 'removeFormat'] as $id => $after) {
    $editor = Editor::load($id);
    if (!$editor) {
      continue;
    }
    $settings = $editor->getSettings();
    $items = $settings['toolbar']['items'] ?? [];
    if (array_intersect($buttons, $items)) {
      continue;
    }
    $position = array_search($after, $items, TRUE);
    $position = $position === FALSE ? count($items) : $position + 1;
    array_splice($items, $position, 0, ['|', ...$buttons]);
    $settings['toolbar']['items'] = $items;
    $editor->setSettings($settings);
    $editor->save();
    $done[] = 'added the Font buttons to the ' . $id . ' editor';
  }
  return $done ? ucfirst(implode('; ', $done)) . '.' : 'Nothing to do.';
}

/**
 * Lets the Website administrator role use the External sites page (added 2026-11-19). New sites get it from
 * config/install.
 */
function bible_admin_update_11007(): string {
  $role = Role::load('website_administrator');
  if (!$role || $role->hasPermission('use external sites')) {
    return 'Nothing to do.';
  }
  $role->grantPermission('use external sites');
  $role->save();
  return 'Let the ' . $role->label() . ' role use the external sites.';
}
